/**
 * @addtogroup HdiUdx
 *
 * @brief Provides unified APIs for Udx services to access Udx drivers.
 *
 * A Udx service can obtain interface object to access different types of devices, 
 * thereby handling file operations and data communication by pushing them down, 
 * and optimizing the paths for transmission, with the aim of reducing the system load.
 *
 * @since 7.0
 * @version 1.0
 */

package ohos.hdi.udx.v1_0;

import ohos.hdi.udx.v1_0.IUdxTypes;

/**
 * @brief Defines the callbacks of the UdxMessage.
 *
 * The following callbacks are provided:
 * - Callback invoked when a message is received by the filter.
 * The callbacks are registered by using RegisterMessageCallback of the IUdxFilter.
 */

[callback] interface IUdxMessageCallback {
    /**
     * @brief Callback function of IUdxMessageCallback.
     * @param The pointer of message.
     * @return Returns HDI_UDX_SUCCESS if the operation is successful; For details about the error codes, see HdiUdxStatus.
     *
     * @since 7.0
     * @version 1.0
     */
    OnUdxMessage([in] Pointer msg);
}