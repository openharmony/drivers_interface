/**
 * @addtogroup power
 * @{
 *
 * @brief Provides APIs for performing suspend/wakeup operations, subscribing to the suspend/wakeup state,
 * and managing running locks.
 * 
 * After obtaining an object or proxy of this module, the power service can invoke related APIs to perform
 * suspend/wakeup operations, subscribe to the suspend/wakeup state, and manage running locks.
 *
 * @since 3.1
 * @version 1.1
 */

/**
 * @file IPowerInterface.idl
 *
 * @brief Provides APIs for performing suspend/wakeup operations, subscribing to the suspend/wakeup state,
 * and managing running locks.
 *
 * 
 *
 * @since 3.1
 * @version 1.1
 */

package ohos.hdi.power.v1_4;

import ohos.hdi.power.v1_3.IPowerInterface;

/**
 * @brief Represents APIs for performing suspend/wakeup operations, subscribing to the suspend/wakeup state,
 * and managing running locks.
 *
 * @since 3.1
 * @version 1.1
 */
interface IPowerInterface extends ohos.hdi.power.v1_3.IPowerInterface {
    /**
     * @brief Extended force suspend.
     *
     * @param mode Suspend policy. "auto" uses ForceSuspend (active suspend / AutoSuspendLoop).
     *             "ignore_wakelock" writes tag to /sys/power/state, skipping wakelock and
     *             wakeup_count checks.
     * @param tag Suspend type used when mode is "ignore_wakelock": "mem" for S3, "ulsr" for ULSR.
     *            Ignored when mode is "auto".
     * @return Returns <b>HDF_SUCCESS</b> if the operation is successful. Returns a negative value otherwise.
     *
     * @since 7.0
     * @version 1.0
     */
    ForceSuspendEx([in] String mode, [in] String tag);
}
/** @} */
