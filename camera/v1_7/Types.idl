/**
 * @file Types.h
 *
 * @brief Declares data types
 * used by the Hardware Driver Interfaces (HDIs) of this module.
 *
 * @since 7.0
 * @version 1.7
 */

package ohos.hdi.camera.v1_7;

import ohos.hdi.camera.v1_0.Types;
import ohos.hdi.camera.v1_2.Types;
import ohos.hdi.camera.v1_3.Types;
import ohos.hdi.camera.v1_4.Types;
import ohos.hdi.camera.v1_5.Types;
import ohos.hdi.camera.v1_6.Types;

sequenceable ohos.hdi.camera.v1_0.BufferHandleSequenceable;
sequenceable ohos.hdi.camera.v1_0.MapDataSequenceable;

/**
 * @brief Enumerates types of the extended stream information.
 * @since 7.0
 * @version 1.0
 */
enum ExtendedStreamInfoType : ohos.hdi.camera.v1_3.ExtendedStreamInfoType {
    /**
     * Extended stream enhanced gainmap.
     * @since 7.0
     * @version 1.0
     */
    EXTENDED_STREAM_OHOS_ENHANCED_GAINMAP = 19
};

/**
 * @brief Defines the ImageBufferInfo_V1_7, which is used by {@link IImageProcessCallback::OnProcessDone_V1_7}.
 * @since 7.0
 * @version 1.7
 */
struct ImageBufferInfo_V1_7 {
    /**
     * @brief Defines the ImageBufferInfo_V1_4, which is used by {@link IImageProcessCallback::OnProcessDone_V1_4}.
     * @since 7.0
     * @version 1.7
     */
    struct ImageBufferInfo_V1_4 v1_4;

    /**
     * @brief Indicates whether the extended gainmap is valid.
     * @since 7.0
     * @version 1.7
     */
    boolean isExtendedGainMapValid;

    /**
     * @brief The handle for the extended gainmap buffer.
     * @since 7.0
     * @version 1.7
     */
    BufferHandleSequenceable extendedGainMapHandle;
};