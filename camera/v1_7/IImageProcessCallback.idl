package ohos.hdi.camera.v1_7;

import ohos.hdi.camera.v1_7.Types;
import ohos.hdi.camera.v1_6.IImageProcessCallback;

/**
 * @file iimage_process_callback.h
 *
 * @brief Declares callbacks for image process.
 *
 * @since 7.0
 * @version 1.7
 */
[callback] interface IImageProcessCallback extends ohos.hdi.camera.v1_6.IImageProcessCallback {
    /**
     * @brief Called when the process done.
     * For details about the reporting mode, see {@link SetResultMode}.
     *
     * @param imageId Indicates the image ID.
     * @param buffer Indicates buffer.
     *
     * @since 7.0
     * @version 1.7
     */
    OnProcessDone_V1_7([in] String imageId, [in] ImageBufferInfo_V1_7[] buffer);
}
